// Brincado de CRUD com CLI
add "sys" ->terminal_clear;
add "time" ->sleep,date_str;

fun cadastramento(indice,nome,idade,genero_biologico){
    var -obj self = { 
        "indice": indice, 
        "nome": nome, 
        "idade": idade, 
        "genero_biologico": genero_biologico ,
        "exames": [],
        "cpf": nil,
    };

    fun add_exame(exame){ if (exame !in self.exames){ self.exames.append(exame); } }

    fun add_cpf(num){ if (num != nil and self.cpf == nil){  self.cpf = num; } }

    self.add_exame = add_exame;
    self.add_cpf = add_cpf;
    return self;
}

fun limpar_tela(tempo) { terminal_clear(); sleep(tempo); }

fun imprimir_dados_cadastrados(dados_cadastrados){
    var -l valores = dados_cadastrados.values;
    var -l chaves = dados_cadastrados.keys;
    var -i indice = dados_cadastrados.length;

    limpar_tela(0.2);
    print "Dados do cadastro:".upper_letters;
    for (var -i a = 0; a < indice; a = a + 1) {
        var -s nome_chave = $"{chaves[a]}".capitalize_phrase;
        print $"{nome_chave}: {valores[a]}";
    }
}

fun pre_cadrastramento(tamanho_da_lista){
    var -s indicie;
    var -s nome;
    var -i idade;
    var -s genero_biologico;
    var -s exame;
    var -s cpf;

    limpar_tela(0.5);
    print "Novo Cadastro:".upper_letters;
    indicie = indicie.if_value_is_null_replace_with("nulo");
    while (indicie == "nulo" ){
        var -s sufixo_indice = date_str("dd/mm/aaaa");
        sufixo_indice = sufixo_indice.replace_elements("/", "");
        indicie = $"{tamanho_da_lista + 1}-{sufixo_indice}";
        indicie = indicie.upper_letters;
        if (sufixo_indice == "") { indicie = "nulo"; }
    }

    nome = nome.if_value_is_null_replace_with("nulo"); 
    while ( nome == "nulo" or nome.is_num == -T){
        input "Digite o nome completo: " >> nome;
        nome = nome.capitalize_phrase;
        if (nome == "") { nome = "nulo"; }
    }

    while (idade == nil or idade.is_num == -F){
        input "Digite a idade: " >> idade;
        if (idade == "" or 0 > idade) { idade = nil; }
    }

    cpf = cpf.if_value_is_null_replace_with("nulo");
    while (cpf == "nulo" or cpf.length != 11){
        var -s entrada_cpf;
        input "Digite o CPF: " >> entrada_cpf;
        entrada_cpf = entrada_cpf.replace_elements(".", "").replace_elements("-", "");
        if (entrada_cpf == "") { cpf = "nulo"; } else { cpf = entrada_cpf; }
    }

    genero_biologico = genero_biologico.if_value_is_null_replace_with("nulo");
    while (genero_biologico == "nulo" or genero_biologico !in ["A","B","C","D"] ){
        limpar_tela(1);

        print "Os generos válidos são:";
        print "A) Masculino - Cis";
        print "B) Feminino - Cis";
        print "C) Masculino - Trans";
        print "D) Feminino - Trans";

        input "Digite o gênero biologico [A, B, C ou D]: " >> genero_biologico;
        genero_biologico = genero_biologico.upper_letters;
        if (genero_biologico == "") { genero_biologico = "nulo"; }
        limpar_tela(1);
    }

    exame = exame.if_value_is_null_replace_with("nulo");
    while (exame == "nulo") {
        limpar_tela(1);

        print "Os exames válidos são:";
        print "A) Raio-X";
        print "B) Hemograma";
        print "C) Glicose";
        print "D) Colesterol";

        input "Digite o exame: " >> exame;
        exame = exame.upper_letters;
        if (exame == "") { exame = "nulo"; }
    }
    
    if (genero_biologico == "A") { genero_biologico = "Masculino - Cis";}
    if (genero_biologico == "B") { genero_biologico = "Feminino - Cis";}
    if (genero_biologico == "C") { genero_biologico = "Masculino - Trans";}
    if (genero_biologico == "D") { genero_biologico = "Feminino - Trans";}

    if (exame == "A") { exame = "Raio-X";}
    if (exame == "B") { exame = "Hemograma";}
    if (exame == "C") { exame = "Glicose";}
    if (exame == "D") { exame = "Colesterol";}

    var -obj cadastro = cadastramento(indicie,nome, idade, genero_biologico);
    cadastro.add_exame(exame);
    cadastro.add_cpf(cpf);
    imprimir_dados_cadastrados(cadastro);
    return cadastro;
}

fun remover_cadastro(lista_de_cadastros, cpf){
    var -l chaves = lista_de_cadastros.keys;
    var -l valores  = lista_de_cadastros.values;
    var -d dict_atualizada = {};
    var -l temporaria;
    var -l temporaria2;

    for (var -i a = 0; a < chaves.length; a = a + 1){
        if (cpf != chaves[a]){ 
            temporaria[a] = chaves[a];
            temporaria2[a] = valores[a];
        } else {
            temporaria[a] = nil;
            temporaria2[a] = nil;
        }
    }
    temporaria = temporaria.rm_nil;
    temporaria2 = temporaria2.rm_nil;

    for (var -i a = 0; a < temporaria.length; a = a + 1){
        dict_atualizada[temporaria[a]] = temporaria2[a];
    }

    return dict_atualizada;
}  

var -d dict_de_cadastros = {};
var -i limite = dict_de_cadastros.length;

for (var -i a = 0; a < limite +1; a = a + 1) {
    var -obj cadastro = pre_cadrastramento(dict_de_cadastros.length);
    dict_de_cadastros[cadastro.cpf] = cadastro; 
}

print "";
print "Lista de cadastros:";
print dict_de_cadastros;
print "";
print "Removendo cadastro:";
dict_de_cadastros = remover_cadastro(dict_de_cadastros, "02386872360");
print dict_de_cadastros;
