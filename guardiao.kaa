// Script para fabricar personagem da classe Guardião

fun CriarGuardiao(nome, mana_inicial, hp) {
    var -f energia = hp;

    var -obj self = {
        "nome": nome,
        "energia": energia,
        "mochila": [],
        "mana": mana_inicial
    };

    fun coletar(item) {
        if (self.mochila.length < 20) {
            // Em Kaa, adiciona no final da lista indexando pelo tamanho atual
            self.mochila[self.mochila.length] = item;
            print "Item '" + item + "' adicionado! Espaço ocupado: ", self.mochila.length, "/20";
        } else {
            print "Mochila cheia! Descarte algo primeiro.";
        }
    }

    fun gastar_energia(qnt) {
        if (self.energia > 0) {
            self.energia = self.energia - qnt;
            self.energia = self.energia.f_valuation(2);
            print "Gastou energia. Energia restante: ", self.energia;
        } else {
            print "Energia esgotada! Descanse um pouco.";
        }
    }

    fun descartar_item(nome) {
        for (var -i i = 0; i < self.mochila.length; i = i + 1) {
            if (self.mochila[i] == nome) {
                self.mochila[i] = nil;
            }
        }
        // Compacta a lista removendo os nulos
        self.mochila = self.mochila.rm_nil;
        print $"Item {nome} descartado com sucesso!";
    }

    fun atacar() {
        if (self.mana >= 2) {
            self.mana = self.mana - 2;
            print $"Guardião {self.nome} lançou magia! Mana restante: ", self.mana;
        } else {
            print "Sem mana suficiente para atacar!";
        }
    }

    // ── INJEÇÃO DOS MÉTODOS NO S-BOT ──
    self.coletar = coletar;
    self.gastar_energia = gastar_energia;
    self.descartar_item = descartar_item;
    self.atacar = atacar;

    return self;
}

fun inicio() {
    var -s nome = "";
    var -f mana_inicial = 0;
    var -f hp = 0;

    input "Digite o nome do guardião: " >> nome;
    input $"Digite a mana inicial do guardião {nome.capitalize_phrase()}: " >> mana_inicial;
    input $"Digite o HP (energia) do guardião {nome.capitalize_phrase()}: " >> hp;

    var -obj guardiao = CriarGuardiao(nome.capitalize_phrase(), mana_inicial, hp);
    return guardiao;
}

fun exibir_status(guardiao) {
    print "";
    print $"""=================================
RELATÓRIO DO GUARDIÃO
=================================
Nome: {guardiao.nome}
Energia: {guardiao.energia}
Mana: {guardiao.mana}
Mochila: {guardiao.mochila} (Total: {guardiao.mochila.length} itens)
=================================
""";
}

// ── FLUXO PRINCIPAL DO JOGO ──
print "=== BEM-VINDO À FLORESTA KAA ===";
var -obj guardiao = inicio();
var -T control = -T;

while (control == -T) {
    var -s item = "";
    print "";
    input "Digite o nome de um item para coletar: " >> item;
    
    // Usa o método nativo do S-Bot
    guardiao.coletar(item);
    guardiao.gastar_energia(3.5);

    item = "";
    input "Digite o nome de um item para descartar: " >> item;
    guardiao.descartar_item(item);

    var -s acao = "";
    print "";
    input "Deseja atacar um monstro? [s/n]: " >> acao;
    if (acao.lower_letters == "s") {
        guardiao.atacar();
    }

    var -s sair = "";
    print "";
    input "Deseja encerrar a expedição? [s/n]: " >> sair;
    if (sair.lower_letters == "s") {
        control = -F;
    }
}

exibir_status(guardiao);
print "Fim da jornada na Floresta Kaa!";