fun teste_vazio() {
    var -f moeda = "";
    
    while (moeda.length > 0 or moeda == "") {
        input "Digite o valor a ser convertido: " >> moeda;
        if (moeda.length > 0) {
            print "Erro: Voce digitou uma string: ", moeda;
        }
        if (moeda == "") {
            print "Erro: Voce nao digitou nada!";
        }
    }
    
    return moeda;

}

var -i valor_moeda = teste_vazio(); 
// Deve dar erro devido ao Stricte mode do tipo de retorno da função e da variavel não são o mesmo

