// To Do List

add "./to_do_list/sair.kaa" all;
add "./to_do_list/menu.kaa" all;
add "./to_do_list/opcao.kaa" all;

var -d atividades;
var -T controle;
var -i opcao;

while (controle != -F) {
    opcao = menu();
    if (opcao == 1){ atividades = opcao1(atividades); }
    if (opcao == 2){ opcao2(atividades); }
    if (opcao == 3){ atividades = opcao3(atividades); }
    if (opcao == 4){ controle = sair(); }
}