fun menu(){
    var -i opcao;
    var -l opcoes = [1, 2, 3, 4];
    print ""; 
    print "------- To Do List ------"; 
    print "1. Adicionar atividade"; 
    print "2. Listar atividades"; 
    print "3. Remover atividade";
    print "4. Sair";
    while(opcao !in opcoes and opcao.is_num!=-T){ input "Escolha uma opção: " >> opcao;}
    return opcao;
}

expor all;