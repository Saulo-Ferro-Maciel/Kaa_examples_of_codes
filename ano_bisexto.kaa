// CÓDIGO DE EXEMPLO DE UMA FORMA DE CRIAR UMA FUNÇÃO VIVA QUE CALCULAR SE ANO É BISEXTO

fun Leap_Year_Calc(aux,msg1,msg2){
    msg1 = "Ano bisexto: " + aux;
    msg2 = "não é ano bisexto: " + aux;
    if (aux % 4 == 0){
        if (aux % 100 == 0){
            if (aux % 400 == 0) {print msg1.upper_letters();}
            else {print msg2.upper_letters();}
        }
        else {print msg1.upper_letters();}
    }
    else {print msg2.upper_letters();}
}

fun is_Leap_This_Year(year) {
    var -i_big length = year.length;
    var -F loop;
    var -i_big aux;
    var -s msg1;
    var -s msg2;

    if (length > 1){ loop = -T; }
    if (loop == -T){
        if(year.keys == nil and year.values == nil){
            for (var -i_big i = 0; i < length; i = i + 1) {
                aux = year[i];
                Leap_Year_Calc(aux,msg1,msg2);
            }
        }
        else{
            for(var -i_big i = 0; i < length; i = i + 1){
                aux = year.values[i];
                Leap_Year_Calc(aux,msg1,msg2);
            }
        }
    }
    else {
        aux = year;
        Leap_Year_Calc(aux,msg1,msg2);
    }
}

print "";
print "Testando com uma lista de anos:".capitalize_phrase();
print "";
is_Leap_This_Year([2020,1992,1980,1984,1988,1996,2000,2004,2008,2012,2016,2001,1900]);

print "";
print "Testando com uma tupla de anos:".capitalize_phrase();
print "";
is_Leap_This_Year((2020,1992,1980,1984,1988,1996,2000,2004,2008,2012,2016,2001,1900));

print "";
print "Testando com um dicionario de anos:".capitalize_phrase();
print "";
is_Leap_This_Year({"a":2020,"b":1992,"c":1980,"d":1984,"e":1988,"f":1996,"g":2000,"h":2004,"i":2008,"j":2012,"k":2016,"l":2001,"m":1900});